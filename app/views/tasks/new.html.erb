<%= form_with model: @task do |f| %>
  <%= f.label :title %>
  <%= f.text_field :title %>
  <%= f.label :details %>
  <%= f.text_field :details %>
  <%= f.check_box :completed %>
  <%= f.label :completed, "Task completed" %>
  <%= f.submit %>
<% end %>

<p></p>

<div>
  <%= link_to 'Back to list', tasks_path %>
</div>
